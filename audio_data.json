  "tempoBpm": 124.0,
  "title": "Aphrodite",
  "artist": "The Ridleys",
  "theme": "Goddess of Beauty & Oceans",
  "lyrics": [
    {
      "id": 1,
      "start": 0.12,
      "end": 3.78,
      "text": "You're the moon that glows in the sky",
      "words": [
        "You're",
        "the",
        "moon",
        "that",
        "glows",
        "in",
        "the",
        "sky"
      ]
    },
    {
      "id": 2,
      "start": 3.88,
      "end": 8.28,
      "text": "Lighting up the world when it's blue",
      "words": [
        "Lighting",
        "up",
        "the",
        "world",
        "when",
        "it's",
        "blue"
      ]
    },
    {
      "id": 3,
      "start": 8.38,
      "end": 11.76,
      "text": "Stars they dance, though late in the night",
      "words": [
        "Stars",
        "they",
        "dance",
        "though",
        "late",
        "in",
        "the",
        "night"
      ]
    },
    {
      "id": 4,
      "start": 11.86,
      "end": 18.36,
      "text": "Don't you know they dance just for you?",
      "words": [
        "Don't",
        "you",
        "know",
        "they",
        "dance",
        "just",
        "for",
        "you"
      ]
    },
    {
      "id": 5,
      "start": 34.93,
      "end": 38.53,
      "text": "There you are, above darkened clouds",
      "words": [
        "There",
        "you",
        "are",
        "above",
        "darkened",
        "clouds"
      ]
    },
    {
      "id": 6,
      "start": 38.63,
      "end": 42.64,
      "text": "Smiling at the world from afar",
      "words": [
        "Smiling",
        "at",
        "the",
        "world",
        "from",
        "afar"
      ]
    },
    {
      "id": 7,
      "start": 42.74,
      "end": 46.07,
      "text": "With the stars, you wander around",
      "words": [
        "With",
        "the",
        "stars",
        "you",
        "wander",
        "around"
      ]
    },
    {
      "id": 8,
      "start": 46.17,
      "end": 51.35,
      "text": "May they follow you wherever you are",
      "words": [
        "May",
        "they",
        "follow",
        "you",
        "wherever",
        "you",
        "are"
      ]
    },
    {
      "id": 9,
      "start": 51.45,
      "end": 54.09,
      "text": "Here I am, just another boy",
      "words": [
        "Here",
        "I",
        "am",
        "just",
        "another",
        "boy"
      ]
    },
    {
      "id": 10,
      "start": 54.19,
      "end": 59.58,
      "text": "Singing songs that others have sung",
      "words": [
        "Singing",
        "songs",
        "that",
        "others",
        "have",
        "sung"
      ]
    },
    {
      "id": 11,
      "start": 59.68,
      "end": 62.23,
      "text": "Tryin' to find the words to employ",
      "words": [
        "Tryin'",
        "to",
        "find",
        "the",
        "words",
        "to",
        "employ"
      ]
    },
    {
      "id": 12,
      "start": 62.33,
      "end": 67.26,
      "text": "To adore the goddess of love",
      "words": [
        "To",
        "adore",
        "the",
        "goddess",
        "of",
        "love"
      ]
    },
    {
      "id": 13,
      "start": 67.36,
      "end": 71.5,
      "text": "Ohh, you've got me in a daze, yeah",
      "words": [
        "Ohh",
        "you've",
        "got",
        "me",
        "in",
        "a",
        "daze",
        "yeah"
      ]
    },
    {
      "id": 14,
      "start": 71.6,
      "end": 75.27,
      "text": "No, it's not another phase",
      "words": [
        "No",
        "it's",
        "not",
        "another",
        "phase"
      ]
    },
    {
      "id": 15,
      "start": 75.37,
      "end": 81.88,
      "text": "You gave me one look and now I can't get my mind off of you",
      "words": [
        "You",
        "gave",
        "me",
        "one",
        "look",
        "and",
        "now",
        "I",
        "can't",
        "get",
